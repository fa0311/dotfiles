#!/bin/bash
# {{ include "../../shared/vscode/extensions.tsv" | sha256sum }}
# {{ include "private_dot_config/cursor/extensions.tsv" | sha256sum }}
set -uo pipefail

install_from_tsv() {
  local cli="$1" tsv="$2"
  [ -x "$cli" ] || return 0
  local current="" installed=""
  while IFS=$'\t' read -r profile ext; do
    [ -z "$ext" ] && continue
    if [ "$profile" != "$current" ]; then
      current="$profile"
      if [ "$profile" = default ]; then
        installed="$("$cli" --list-extensions 2>/dev/null)"
      else
        installed="$("$cli" --profile "$profile" --list-extensions 2>/dev/null)"
      fi
    fi
    grep -qix "$ext" <<<"$installed" && continue
    if [ "$profile" = default ]; then
      "$cli" --install-extension "$ext" --force
    else
      "$cli" --profile "$profile" --install-extension "$ext" --force
    fi
  done <"$tsv"
}

install_from_tsv "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" "$HOME/.config/vscode/extensions.tsv"
install_from_tsv "/Applications/Cursor.app/Contents/Resources/app/bin/cursor" "$HOME/.config/cursor/extensions.tsv"
